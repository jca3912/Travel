# Copia este fichero como ".env" (sin .example).
# Sólo hace falta si usas provider = "serpapi" en config.toml.
# Con provider = "gflights" (por defecto) no necesitas ninguna clave.
#
# La clave se saca en https://serpapi.com — plan básico 25 $/mes, 1.000 búsquedas.
# Nunca subas el .env a ningún sitio ni lo compartas.

SERPAPI_KEY=
